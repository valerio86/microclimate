# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Ambient Weather Network (WS-2902) ---
# ambientweather.net -> Account -> API Keys
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
# Device MAC, e.g. 00:11:22:33:44:55 (see `microclimate devices` to list yours)
AMBIENT_MAC=

# --- PurpleAir ---
# Read key from PurpleAir (develop.purpleair.com)
PURPLEAIR_API_KEY=
PURPLEAIR_SENSOR_INDEX=

# --- Location ---
# Used for Open-Meteo forecast retrieval. Elevation matters a lot for microclimates.
LATITUDE=
LONGITUDE=
ELEVATION_M=
# IANA timezone, e.g. America/Los_Angeles
TIMEZONE=

# --- Storage ---
DATA_DIR=./data
